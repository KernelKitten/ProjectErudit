@* AuthorizeRouteView проверяет [Authorize] у страницы: нет входа — на /login, нет нужной роли — сообщение. *@
<Router AppAssembly="typeof(Program).Assembly" NotFoundPage="typeof(Pages.NotFound)">
    <Found Context="routeData">
        <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(Layout.MainLayout)">
            <NotAuthorized>
                @if (context.User.Identity?.IsAuthenticated == true)
                {
                    <MudAlert Severity="Severity.Warning" Class="ma-4">
                        Эта страница недоступна в текущей роли. Переключите роль в правом верхнем углу.
                    </MudAlert>
                }
                else
                {
                    <RedirectToLogin />
                }
            </NotAuthorized>
        </AuthorizeRouteView>
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
</Router>

@code {
    [Inject] private ThemeState Theme { get; set; } = null!;

    /// <summary>Тема из cookie (App.razor). Параметры корня доходят и до пререндера, и до живой сессии SignalR.</summary>
    [Parameter] public ThemeMode ThemeMode { get; set; }
    [Parameter] public bool SystemDark { get; set; }

    protected override void OnInitialized() => Theme.Init(ThemeMode, SystemDark);
}
