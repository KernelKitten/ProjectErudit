@* Вошёл по временному паролю — пока не сменит, любую страницу (кроме смены пароля) заменяем переходом на /account/password.
   Отметка в cookie (EruditClaims.MustChangePassword) снимается после смены пароля (/auth/password). *@
@implements IDisposable
@inject NavigationManager Navigation

@code {
    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = null!;

    private bool _mustChange;

    protected override async Task OnInitializedAsync()
    {
        _mustChange = (await AuthState).User.HasClaim(c => c.Type == EruditClaims.MustChangePassword);
        Navigation.LocationChanged += OnLocationChanged;
        Check();
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) => Check();

    private void Check()
    {
        if (_mustChange && !Navigation.ToBaseRelativePath(Navigation.Uri).StartsWith("account/password", StringComparison.OrdinalIgnoreCase))
        {
            Navigation.NavigateTo("account/password");
        }
    }

    public void Dispose() => Navigation.LocationChanged -= OnLocationChanged;
}
