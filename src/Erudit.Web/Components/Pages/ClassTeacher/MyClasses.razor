@page "/class-teacher"
@attribute [Authorize(Roles = AppRoles.ClassTeacher)]
@inject IDbContextFactory<EruditDbContext> DbFactory
@inject TimeProvider Time

<PageTitle>Мои классы</PageTitle>

<MudText Typo="Typo.h5" GutterBottom>Мои классы</MudText>

@if (_classes is null)
{
    <MudProgressLinear Indeterminate />
}
else if (_classes.Count == 0)
{
    <MudAlert Severity="Severity.Info">В текущем учебном году вы не ведёте ни одного класса.</MudAlert>
}
else
{
    <MudGrid>
        @foreach (var c in _classes)
        {
            <MudItem xs="12" sm="6" md="4">
                <MudPaper Class="pa-4" Outlined>
                    <MudText Typo="Typo.h6">Класс @c.Name</MudText>
                    <MudText Typo="Typo.body2" Class="mb-3">Учеников: @c.Students</MudText>
                    <MudButton Href="@($"classes/{c.Id}")" Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small">
                        Открыть
                    </MudButton>
                </MudPaper>
            </MudItem>
        }
    </MudGrid>
}

@code {
    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = null!;

    private sealed record ClassRow(int Id, string Name, int Students);

    private List<ClassRow>? _classes;

    protected override async Task OnInitializedAsync()
    {
        var personId = (await AuthState).User.GetPersonId();
        var today = DateOnly.FromDateTime(SchoolTime.ToSchool(Time.GetUtcNow().UtcDateTime));

        await using var db = await DbFactory.CreateDbContextAsync();
        _classes = await db.SchoolClasses
            .Where(c => c.ClassTeacherId == personId && c.AcademicYear.StartDate <= today && c.AcademicYear.EndDate >= today)
            .OrderBy(c => c.Grade).ThenBy(c => c.Letter)
            .Select(c => new ClassRow(c.Id, c.Grade + c.Letter,
                db.ClassMemberships.Count(m => m.SchoolClassId == c.Id && m.ToDate == null)))
            .ToListAsync();
    }
}
