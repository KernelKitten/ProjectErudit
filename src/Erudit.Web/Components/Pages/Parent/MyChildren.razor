@page "/parent"
@attribute [Authorize(Roles = AppRoles.Parent)]
@using Erudit.Web.Components.Pages.Student
@inject IDbContextFactory<EruditDbContext> DbFactory

<PageTitle>Мои дети</PageTitle>

<MudText Typo="Typo.h5" GutterBottom>Мои дети</MudText>

@if (_children is null)
{
    <MudProgressLinear Indeterminate />
}
else if (_children.Count == 0)
{
    <MudAlert Severity="Severity.Info">К вам пока не привязан ни один ребёнок. Обратитесь к классному руководителю.</MudAlert>
}
else
{
    @if (_children.Count > 1)
    {
        <MudSelect T="int" @bind-Value="_childId" Label="Ребёнок" Class="mb-3" Style="max-width: 320px">
            @foreach (var child in _children)
            {
                <MudSelectItem T="int" Value="child.Id">@child.Label</MudSelectItem>
            }
        </MudSelect>
    }
    var selected = _children.First(c => c.Id == _childId);
    <MudText Typo="Typo.subtitle1"><b>@selected.Label</b></MudText>
    <MudText Typo="Typo.body2" Class="mb-3">
        Уведомления: @(selected.NotifyAll ? "все уведомления о занятиях" : "еженедельная сводка")
    </MudText>
    <StudentLessonsPanel StudentId="_childId" />
}

@code {
    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = null!;
    private List<ChildRow>? _children;
    private int _childId;

    private sealed record ChildRow(int Id, string Name, string ClassName, bool NotifyAll)
    {
        public string Label => ClassName.Length == 0 ? Name : $"{Name}, {ClassName}";
    }

    protected override async Task OnInitializedAsync()
    {
        var personId = (await AuthState).User.GetPersonId();

        await using var db = await DbFactory.CreateDbContextAsync();
        _children = await db.ParentLinks
            .Where(l => l.ParentId == personId && l.Student.IsActive)
            .OrderBy(l => l.Student.LastName).ThenBy(l => l.Student.FirstName)
            .Select(l => new ChildRow(
                l.StudentId,
                l.Student.LastName + " " + l.Student.FirstName,
                db.ClassMemberships.Where(m => m.StudentId == l.StudentId && m.ToDate == null)
                    .Select(m => m.SchoolClass.Grade + m.SchoolClass.Letter).FirstOrDefault() ?? "",
                l.NotifyAll))
            .ToListAsync();
        _childId = _children.FirstOrDefault()?.Id ?? 0;
    }
}
