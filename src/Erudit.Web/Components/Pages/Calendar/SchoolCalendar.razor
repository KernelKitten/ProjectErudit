@page "/calendar"
@attribute [Authorize]
@using Erudit.Domain.Calendar
@using Erudit.Infrastructure.Calendar
@inject IDbContextFactory<EruditDbContext> DbFactory
@inject IServiceScopeFactory Scopes
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject TimeProvider Time

<PageTitle>Календарь</PageTitle>

<MudStack Row Wrap="Wrap.Wrap" AlignItems="AlignItems.Center" Class="mb-2">
    <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft" OnClick="() => MoveAsync(-1)" aria-label="Назад" />
    <MudText Typo="Typo.h5" Style="min-width: 220px; text-align: center">@Title</MudText>
    <MudIconButton Icon="@Icons.Material.Filled.ChevronRight" OnClick="() => MoveAsync(1)" aria-label="Вперёд" />
    <MudButton Variant="Variant.Text" OnClick="TodayAsync">Сегодня</MudButton>
    <MudToggleGroup T="CalendarView" Value="_view" ValueChanged="ChangeViewAsync" Size="Size.Small" Outlined Delimiters>
        <MudToggleItem Value="CalendarView.Month" Text="Месяц" />
        <MudToggleItem Value="CalendarView.Quarter" Text="Квартал" />
        <MudToggleItem Value="CalendarView.HalfYear" Text="Полгода" />
        <MudToggleItem Value="CalendarView.Year" Text="Год" />
    </MudToggleGroup>
    <MudSpacer />
    @if (_canEdit)
    {
        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Outlined.CloudDownload" OnClick="LoadFromGitHubAsync"
                   Disabled="_busy">Загрузить с GitHub</MudButton>
        @* MudBlazor 9: своя кнопка внутри CustomContent сама открывает выбор файла — upload.OpenFilePickerAsync. *@
        <MudFileUpload T="IBrowserFile" Accept=".json" FilesChanged="UploadAsync" Disabled="_busy">
            <CustomContent Context="upload">
                <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Outlined.UploadFile" Disabled="_busy"
                           OnClick="upload.OpenFilePickerAsync">Загрузить файл</MudButton>
            </CustomContent>
        </MudFileUpload>
    }
</MudStack>

@if (_busy)
{
    <MudProgressLinear Indeterminate Class="mb-2" />
}

@if (_view == CalendarView.Month)
{
    <div style="max-width: 700px">
        <MonthGrid Month="_start" Days="_days" OnDayClick="EditDayAsync" />
    </div>
}
else
{
    @* Несколько месяцев: сетка сама раскладывает их по 2–4 в ряд в зависимости от ширины экрана. *@
    <div class="erudit-months">
        @foreach (var month in Months)
        {
            <MonthGrid Month="month" Days="_days" Compact OnDayClick="EditDayAsync" />
        }
    </div>
}

<MudStack Row Wrap="Wrap.Wrap" Spacing="4" Class="mt-3">
    <span><span class="erudit-legend erudit-legend-off"></span>нерабочий день</span>
    <span><span class="erudit-legend erudit-legend-vacation"></span>каникулы</span>
    <span><span class="erudit-legend erudit-legend-vacation-part"></span>каникулы у части классов</span>
    <span><MudIcon Icon="@Icons.Material.Outlined.Edit" Size="Size.Small" Style="vertical-align: middle" /> исправлено вручную</span>
</MudStack>
@if (_canEdit)
{
    <MudText Typo="Typo.caption" Class="d-block mt-2">
        Нажмите на день, чтобы сделать его рабочим или нерабочим. Календарь также обновляется сам каждый понедельник.
    </MudText>
}

@code {
    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = null!;

    /// <summary>Вид календаря; число — сколько месяцев показываем.</summary>
    private enum CalendarView { Month = 1, Quarter = 3, HalfYear = 6, Year = 12 }

    private CalendarView _view = CalendarView.Month;
    private DateOnly _today;
    private DateOnly _start; // первое число первого показанного месяца
    private Dictionary<DateOnly, CalendarCell> _days = [];
    private bool _canEdit;
    private bool _busy;

    private int MonthCount => (int)_view;

    private IEnumerable<DateOnly> Months => Enumerable.Range(0, MonthCount).Select(i => _start.AddMonths(i));

    private string Title => _view switch
    {
        CalendarView.Month => _start.ToString("MMMM yyyy"),
        CalendarView.Year => $"{_start.Year} год",
        _ => $"{_start:MMMM} — {_start.AddMonths(MonthCount - 1):MMMM yyyy}",
    };

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthState).User;
        _canEdit = user.IsInRole(AppRoles.Admin) || user.IsInRole(AppRoles.HeadTeacher);
        _today = DateOnly.FromDateTime(SchoolTime.ToSchool(Time.GetUtcNow().UtcDateTime));
        _start = AlignStart(_today);
        await LoadAsync();
    }

    /// <summary>
    /// Начало периода, в который попадает дата: квартал — январь/апрель/июль/октябрь,
    /// полгода — январь/июль, год — январь, месяц — сам месяц.
    /// </summary>
    private DateOnly AlignStart(DateOnly date)
    {
        var monthIndex = (date.Month - 1) / MonthCount * MonthCount; // 0, 3, 6, 9 для квартала
        return new DateOnly(date.Year, monthIndex + 1, 1);
    }

    private async Task ChangeViewAsync(CalendarView view)
    {
        _view = view;
        _start = AlignStart(_start);
        await LoadAsync();
    }

    private async Task MoveAsync(int direction)
    {
        _start = _start.AddMonths(direction * MonthCount);
        await LoadAsync();
    }

    private async Task TodayAsync()
    {
        _start = AlignStart(_today);
        await LoadAsync();
    }

    /// <summary>Один запрос за весь показанный период — и для месяца, и для года.</summary>
    private async Task LoadAsync()
    {
        var first = _start;
        var last = _start.AddMonths(MonthCount).AddDays(-1);

        await using var db = await DbFactory.CreateDbContextAsync();
        var days = await db.CalendarDays.Where(d => d.Date >= first && d.Date <= last).ToListAsync();
        var vacations = await db.Vacations.Where(v => v.StartDate <= last && v.EndDate >= first).ToListAsync();
        var calendar = new WorkingDayCalendar(days);
        var manual = days.Where(d => d.IsManual).Select(d => d.Date).ToHashSet();

        _days = [];
        for (var date = first; date <= last; date = date.AddDays(1))
        {
            var current = date;
            var active = vacations.Where(v => current >= v.StartDate && current <= v.EndDate).ToList();
            _days[date] = new CalendarCell(date, calendar.IsWorkingDay(date), manual.Contains(date), date == _today,
                active.Any(v => v.GradeFrom is null && v.GradeTo is null),
                active.Any(v => v.GradeFrom is not null || v.GradeTo is not null),
                active.Count == 0 ? null : string.Join("; ", active.Select(v => v.Name)));
        }
    }

    private async Task EditDayAsync(CalendarCell cell)
    {
        if (!_canEdit)
        {
            return;
        }
        var dialog = await DialogService.ShowAsync<CalendarDayDialog>("День календаря",
            new DialogParameters<CalendarDayDialog>
            {
                { d => d.Date, cell.Date },
                { d => d.IsWorking, cell.IsWorking },
                { d => d.IsManual, cell.IsManual },
            },
            new DialogOptions { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true });
        var result = await dialog.Result;
        if (result is { Canceled: false, Data: CalendarDayDialog.CalendarDayAction.Reset })
        {
            await LoadFromGitHubAsync(); // узнаём из файла, каким день должен быть
        }
        else if (result is { Canceled: false })
        {
            await LoadAsync();
        }
    }

    private Task LoadFromGitHubAsync() => RunImportAsync(scope =>
        scope.ServiceProvider.GetRequiredService<ProductionCalendarJob>().RunAsync());

    private async Task UploadAsync(IBrowserFile? file)
    {
        if (file is null)
        {
            return;
        }
        // Файл приходит из браузера по сети; читаем целиком в память (календарь — около 50 КБ).
        var buffer = new MemoryStream();
        await file.OpenReadStream(maxAllowedSize: 1024 * 1024).CopyToAsync(buffer);
        buffer.Position = 0;
        await RunImportAsync(scope => scope.ServiceProvider.GetRequiredService<ProductionCalendarImporter>().ImportAsync(buffer));
    }

    /// <summary>
    /// Загрузка в отдельной «области» (scope): свой DbContext на одну операцию, а не на всё время жизни страницы.
    /// В журнал изменений загрузка попадёт с автором — текущим пользователем.
    /// </summary>
    private async Task RunImportAsync(Func<IServiceScope, Task<CalendarImportResult>> import)
    {
        _busy = true;
        try
        {
            await using var scope = Scopes.CreateAsyncScope();
            scope.ServiceProvider.GetRequiredService<EruditDbContext>().CurrentPersonId = (await AuthState).User.GetPersonId();
            var result = await import(scope);
            Snackbar.Add($"Календарь загружен. {result}", Severity.Success);
        }
        catch (Exception ex) when (ex is FormatException or HttpRequestException)
        {
            Snackbar.Add($"Не удалось загрузить календарь: {ex.Message}", Severity.Error);
        }
        finally
        {
            _busy = false;
        }
        await LoadAsync();
    }
}
