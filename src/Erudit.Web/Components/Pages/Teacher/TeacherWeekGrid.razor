@* Неделя учителя сеткой, как школьное расписание: строки — дни, столбцы — уроки.
   Отдельный компонент: учитель видит свою неделю, а завуч и администратор (шаг 6) — неделю любого учителя. *@
@using Erudit.Domain.Lessons
@using Erudit.Infrastructure.Lessons
@inject TeacherWeekService WeekService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IBrowserViewportService Viewport

<MudStack Row Wrap="Wrap.Wrap" AlignItems="AlignItems.Center" Class="mb-2">
    <PeriodNavigator Title="@Title" OnPrevious="() => MoveAsync(-7)" OnNext="() => MoveAsync(7)" OnToday="TodayAsync" />
    @if (CanCreate)
    {
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                   OnClick="() => NewLessonAsync(null, null)">Новое занятие</MudButton>
    }
    <MudSpacer />
    <div class="erudit-week-all">
        <MudSwitch T="bool" @bind-Value="_showAll" Color="Color.Primary">Все уроки</MudSwitch>
    </div>
</MudStack>

@if (CanEdit && _unmarked.Count > 0)
{
    @* Занятия прошли, а отметки нет: показываем все, а не только за эту неделю. *@
    <div class="erudit-unmarked">
        <div class="erudit-unmarked-head" @onclick="() => _showUnmarked = !_showUnmarked">
            <MudIcon Icon="@Icons.Material.Outlined.ErrorOutline" Size="Size.Small" Color="Color.Error" />
            <span>Не отмечено занятий: @_unmarked.Count</span>
            <MudIcon Icon="@(_showUnmarked ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)" Size="Size.Small" />
        </div>
        @if (_showUnmarked)
        {
            @foreach (var u in _unmarked)
            {
                <div class="erudit-unmarked-item" @onclick="() => OpenLessonAsync(u.Id)">
                    @u.Start.ToString("ddd dd.MM"), @u.Start.ToString("H:mm")–@u.Start.AddMinutes(u.DurationMinutes).ToString("H:mm"), @u.Subject
                </div>
            }
        }
    </div>
}

@if (_week is null)
{
    <MudProgressLinear Indeterminate />
}
else if (_week.AllPeriods.Count == 0)
{
    <MudAlert Severity="Severity.Warning">Не заполнено расписание звонков — сетку построить нельзя. Его заполняет администратор или завуч.</MudAlert>
}
else
{
    @* На ноутбуке — сетка. *@
    <div class="erudit-week-table">
        <table>
            <thead>
                <tr>
                    <th class="erudit-week-corner"></th>
                    @foreach (var p in Columns)
                    {
                        <th>
                            <div>@p.Number урок</div>
                            <div class="erudit-week-time">@p.Start.ToString("H:mm")–@p.End.ToString("H:mm")</div>
                        </th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var day in _week.Days)
                {
                    <tr class="@DayClass(day)">
                        <th class="erudit-week-day">
                            <div class="erudit-week-date">@day.Date.ToString("ddd dd.MM")</div>
                            <DayNotes Day="day" />
                        </th>
                        @foreach (var p in Columns)
                        {
                            var cellLessons = _week.Lessons(day.Date, p.Number);
                            var empty = CanCreate && cellLessons.Count == 0;
                            @* Пустая клетка — клик открывает «Новое занятие» с этим днём и уроком. *@
                            <td class="@(empty ? "erudit-week-empty" : null)" title="@(empty ? "Новое занятие" : null)"
                                @onclick="() => empty ? NewLessonAsync(day.Date, p.Number) : Task.CompletedTask">
                                @foreach (var lesson in cellLessons)
                                {
                                    <div class="@LessonClass(lesson)" title="@Tooltip(lesson)" @onclick="() => OpenLessonAsync(lesson.Id)" @onclick:stopPropagation>
                                        <div class="erudit-lesson-subject">
                                            @if (lesson.IsSeries)
                                            {
                                                <MudIcon Icon="@Icons.Material.Outlined.Repeat" Size="Size.Small" Class="erudit-lesson-repeat" />
                                            }
                                            @lesson.SubjectShort
                                        </div>
                                        <div class="erudit-lesson-meta">@lesson.Room · @lesson.Enrolled/@lesson.Capacity</div>
                                        @if (lesson.LessonNumber != p.Number || lesson.StartTime != p.Start)
                                        {
                                            @* Время не совпадает со звонком (задано вручную) — показываем точное. *@
                                            <div class="erudit-lesson-meta">@TimeRange(lesson)</div>
                                        }
                                    </div>
                                }
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @* На телефоне сетка не помещается — список по дням. *@
    <div class="erudit-week-list">
        @foreach (var day in _week.Days)
        {
            <div class="erudit-week-list-day @DayClass(day)">
                <div class="erudit-week-list-head">
                    <span>@day.Date.ToString("dddd, d MMMM")</span>
                    <DayNotes Day="day" />
                </div>
                @{ var lessons = _week.Lessons(day.Date).ToList(); }
                @if (lessons.Count == 0)
                {
                    <div class="erudit-week-list-empty">Занятий нет</div>
                }
                @foreach (var lesson in lessons)
                {
                    <div class="@LessonClass(lesson)" title="@Tooltip(lesson)" @onclick="() => OpenLessonAsync(lesson.Id)" @onclick:stopPropagation>
                        <div class="erudit-lesson-meta">
                            @(lesson.LessonNumber is { } n ? $"{n} урок · " : "")@TimeRange(lesson)
                        </div>
                        <div class="erudit-lesson-subject">
                            @if (lesson.IsSeries)
                            {
                                <MudIcon Icon="@Icons.Material.Outlined.Repeat" Size="Size.Small" Class="erudit-lesson-repeat" />
                            }
                            @lesson.Subject
                        </div>
                        <div class="erudit-lesson-meta">@lesson.Room · записано @lesson.Enrolled из @lesson.Capacity</div>
                    </div>
                }
            </div>
        }
    </div>
}

@code {
    /// <summary>Чью неделю показываем.</summary>
    [Parameter, EditorRequired] public int TeacherId { get; set; }

    /// <summary>Можно ли создавать занятия: у уволенного учителя нельзя.</summary>
    [Parameter] public bool CanCreate { get; set; }

    /// <summary>Можно ли менять и отменять занятия (у уволенного — можно: его будущие занятия надо отменить).</summary>
    [Parameter] public bool CanEdit { get; set; }

    private IReadOnlyList<UnmarkedLesson> _unmarked = [];
    private bool _showUnmarked;
    private int? _loadedTeacherId;
    private DateOnly _monday;
    private bool _showAll;
    private TeacherWeek? _week;

    private IReadOnlyList<Erudit.Domain.School.LessonPeriod> Columns => _showAll ? _week!.AllPeriods : _week!.Columns;

    protected override async Task OnParametersSetAsync()
    {
        if (_monday == default)
        {
            _monday = TeacherWeekService.MondayOf(WeekService.Today);
        }
        // Перезагружаем, только если сменился учитель (неделя при этом остаётся та же):
        // метод вызывается при каждой перерисовке родительской страницы.
        if (_loadedTeacherId != TeacherId)
        {
            _loadedTeacherId = TeacherId;
            await LoadAsync();
        }
    }

    private async Task LoadAsync()
    {
        _week = await WeekService.LoadAsync(TeacherId, _monday);
        if (CanEdit)
        {
            _unmarked = await WeekService.UnmarkedAsync(TeacherId);
        }
    }

    private async Task MoveAsync(int days)
    {
        _monday = _monday.AddDays(days);
        await LoadAsync();
    }

    private async Task TodayAsync()
    {
        _monday = TeacherWeekService.MondayOf(WeekService.Today);
        await LoadAsync();
    }

    /// <summary>Карточка занятия; изменили, отменили или вернули — сообщение и перезагрузка недели.</summary>
    private async Task OpenLessonAsync(int lessonId)
    {
        var phone = await Viewport.GetCurrentBreakpointAsync() <= Breakpoint.Sm;
        var parameters = new DialogParameters<LessonCardDialog>
        {
            { d => d.LessonId, lessonId },
            { d => d.CanEdit, CanEdit },
            { d => d.FullScreen, phone },
        };
        var dialog = await DialogService.ShowAsync<LessonCardDialog>("Занятие", parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, FullScreen = phone, CloseButton = true });
        if (await dialog.Result is { Canceled: false, Data: string message })
        {
            Snackbar.Add(message, Severity.Success);
            await LoadAsync();
        }
    }

    /// <summary>
    /// Окно «Новое занятие». Клик по клетке — её день и урок; кнопка — сегодня (если сегодня в показанной неделе),
    /// иначе понедельник показанной недели. На телефоне окно — на весь экран.
    /// </summary>
    private async Task NewLessonAsync(DateOnly? date, int? lessonNumber)
    {
        var today = WeekService.Today;
        date ??= today >= _monday && today < _monday.AddDays(7) ? today : _monday;
        var parameters = new DialogParameters<NewLessonDialog>
        {
            { d => d.TeacherId, TeacherId },
            { d => d.Date, date.Value },
            { d => d.LessonNumber, lessonNumber },
        };
        var phone = await Viewport.GetCurrentBreakpointAsync() <= Breakpoint.Sm;
        var dialog = await DialogService.ShowAsync<NewLessonDialog>("Новое занятие", parameters,
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, FullScreen = phone, CloseButton = true });

        if (await dialog.Result is { Canceled: false, Data: int created })
        {
            Snackbar.Add($"Создано: {NewLessonDialog.Count(created)}", Severity.Success);
            await LoadAsync();
        }
    }

    /// <summary>«26–30 октября 2026» или «28 сентября – 2 октября 2026».</summary>
    private string Title
    {
        get
        {
            var last = _week?.Days[^1].Date ?? _monday.AddDays(4);
            return _monday.Month == last.Month
                ? $"{_monday.Day}–{last:d MMMM yyyy}"
                : $"{_monday:d MMMM} – {last:d MMMM yyyy}";
        }
    }

    private static string DayClass(WeekDay day) => string.Join(' ', new[]
    {
        day.IsWorking ? null : "erudit-week-off",
        day.VacationAll is not null ? "erudit-week-vacation" : null,
        day.VacationPart is not null ? "erudit-week-vacation-part" : null,
        day.IsToday ? "erudit-week-today" : null,
    }.Where(c => c is not null));

    /// <summary>Занятие закончилось, а отметки нет.</summary>
    private bool IsUnmarked(WeekLesson lesson) =>
        lesson.Status == LessonStatus.Planned && lesson.Start.AddMinutes(lesson.DurationMinutes) <= WeekService.Now;

    private string LessonClass(WeekLesson lesson) => lesson.Status switch
    {
        LessonStatus.Cancelled => "erudit-lesson erudit-lesson-cancelled",
        LessonStatus.Held => "erudit-lesson erudit-lesson-held",
        LessonStatus.NotHeld => "erudit-lesson erudit-lesson-notheld",
        _ when IsUnmarked(lesson) => "erudit-lesson erudit-lesson-unmarked",
        _ => "erudit-lesson",
    };

    private static string TimeRange(WeekLesson lesson) => $"{lesson.StartTime:H:mm}–{lesson.EndTime:H:mm}";

    /// <summary>Подсказка при наведении: всё о занятии одной строкой.</summary>
    private string Tooltip(WeekLesson lesson) => string.Join("\n", new[]
    {
        $"{lesson.Subject}{(lesson.Topic is null ? "" : $": {lesson.Topic}")}",
        $"{TimeRange(lesson)}, {lesson.Room}",
        $"Записано {lesson.Enrolled} из {lesson.Capacity}",
        lesson.IsSeries ? "Регулярное занятие" : "Разовое занятие",
        IsUnmarked(lesson) ? "Не отмечено" : LessonFormat.Status(lesson.Status),
    });
}
