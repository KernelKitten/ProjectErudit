@page "/teacher"
@attribute [Authorize(Roles = AppRoles.Teacher)]

<PageTitle>Мои занятия</PageTitle>

<MudText Typo="Typo.h5" GutterBottom>Мои занятия</MudText>

@if (_personId is { } id)
{
    <TeacherWeekGrid TeacherId="id" />
}

@code {
    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = null!;
    private int? _personId;

    protected override async Task OnInitializedAsync()
    {
        _personId = (await AuthState).User.GetPersonId();
    }
}
