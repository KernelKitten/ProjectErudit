@page "/account/password"
@attribute [Authorize]
@* Пароль для запасного входа (решено 2026-11-13): задать или сменить свой. Только учителям, завучу и администратору.
   Сохранение — обычная HTML-форма на /auth/password: после смены cookie выдаётся заново. *@
@using Erudit.Domain.People
@using Erudit.Infrastructure.Auth
@inject IServiceScopeFactory Scopes

<PageTitle>Пароль для входа</PageTitle>

<MudPaper Class="pa-6 mx-auto" MaxWidth="520px" Elevation="2">
    <MudText Typo="Typo.h5" GutterBottom>Пароль для входа</MudText>

    @if (_state is null)
    {
        <MudProgressLinear Indeterminate />
    }
    else if (!_state.Value.Allowed)
    {
        <MudAlert Severity="Severity.Info">
            Вход по паролю доступен только учителям, завучу и администратору. Ученики и родители входят через MAX.
        </MudAlert>
    }
    else
    {
        @if (_mustChange)
        {
            <MudAlert Severity="Severity.Warning" Class="mb-3">
                Вы вошли по временному паролю от администратора. Придумайте свой пароль — без этого сайт дальше не откроется.
            </MudAlert>
        }
        @if (Done)
        {
            <MudAlert Severity="Severity.Success" Class="mb-3">Пароль сохранён. Теперь можно входить по номеру телефона и паролю.</MudAlert>
        }
        @if (Error == "mismatch")
        {
            <MudAlert Severity="Severity.Error" Dense Class="mb-3">Пароли не совпадают.</MudAlert>
        }
        else if (Error == "invalid")
        {
            <MudAlert Severity="Severity.Error" Dense Class="mb-3">@PersonPassword.Validate(null)</MudAlert>
        }

        @if (!_mustChange)
        {
            <MudText Class="mb-3">
                @(_state.Value.HasPassword ? "Пароль уже задан — здесь его можно сменить." : "Пароль ещё не задан.")
                Он нужен, если MAX не работает: на странице входа — «Войти по паролю», логин — ваш номер телефона.
            </MudText>
        }

        <form method="post" action="auth/password">
            <AntiforgeryToken />
            <input type="hidden" name="password" value="@_password" />
            <input type="hidden" name="confirm" value="@_confirm" />
            <MudTextField @bind-Value="_password" Label="Новый пароль" InputType="InputType.Password" Immediate Class="mb-2"
                          HelperText="@($"Не короче {PersonPassword.MinLength} символов. Удобно — фраза из нескольких слов.")" />
            <MudTextField @bind-Value="_confirm" Label="Ещё раз" InputType="InputType.Password" Immediate Class="mb-2"
                          Error="@(!string.IsNullOrEmpty(_confirm) && _confirm != _password)" ErrorText="Пароли не совпадают" />
            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Class="mt-2"
                       Disabled="@(PersonPassword.Validate(_password) is not null || _password != _confirm)">Сохранить пароль</MudButton>
        </form>
        <MudText Typo="Typo.caption" Class="mt-3 d-block" Style="color: var(--mud-palette-text-secondary)">
            Забыли пароль — войдите через MAX и задайте новый здесь или попросите администратора выдать временный.
            О смене пароля придёт сообщение в MAX.
        </MudText>
    }
</MudPaper>

@code {
    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = null!;

    [SupplyParameterFromQuery] private string? Error { get; set; }
    [SupplyParameterFromQuery(Name = "done")] private bool Done { get; set; }

    private (bool Allowed, bool HasPassword)? _state;
    private bool _mustChange;
    private string? _password;
    private string? _confirm;

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthState).User;
        _mustChange = user.HasClaim(c => c.Type == EruditClaims.MustChangePassword);
        await using var scope = Scopes.CreateAsyncScope();
        _state = await scope.ServiceProvider.GetRequiredService<PasswordService>().StateAsync(user.GetPersonId() ?? 0);
    }
}
